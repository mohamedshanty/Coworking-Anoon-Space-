# Database
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# JWT
JWT_ACCESS_SECRET="your-access-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"

# N8N Integration
N8N_API_KEY="your-n8n-api-key-here"

# Server
NODE_ENV=development
PORT=5001

# CORS (comma-separated — include the public ordering page domain here)
ALLOWED_ORIGINS=http://localhost:8080,https://your-ordering-page.com

# SMTP (for daily report emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="Noon Cowork <noreply@example.com>"

# Daily Report
DAILY_REPORT_CRON="55 23 * * *"
DAILY_REPORT_RECIPIENTS="admin@example.com"

# Anoon QR integration
# Shared secret — MUST be the same value on both this backend and the Anoon QR backend.
# Used as X-Internal-Secret header on both directions (inbound check-ins + outbound member sync).
INTERNAL_SYNC_SECRET="your-shared-internal-secret-here"
# Base URL of the standalone Anoon QR backend (no trailing slash needed), e.g. https://anoon-qr.example.com
ANOON_QR_BASE_URL="https://anoon-qr.example.com"

# MikroTik RouterOS (for noonWiFi hotspot integration)
MIKROTIK_HOST="10.20.0.2"
MIKROTIK_USER="noonapi"
MIKROTIK_PASSWORD="your-mikrotik-api-password"
MIKROTIK_PORT=8728
MIKROTIK_TIMEOUT_SEC=8

# noonWiFi hotspot
# Secret that derives each user's router password from their phone (HMAC).
# REQUIRED for portal login — if MIKROTIK_HOST is set and this is missing,
# every login fails and the server prints a startup warning.
HOTSPOT_USER_SECRET="generate-a-long-random-secret-here"
# Business close time (HH:MM) — visitors are cut at this hour by the EOD sweep
BUSINESS_CLOSE_TIME="22:00"
# Timezone for cron jobs (EOD sweep, idle reconciliation)
TZ_NAME="Asia/Hebron"
# Max devices authorized per phone number
MAX_DEVICES_PER_PHONE=4
# Internet billing mode: "surcharge" (added on top of seat price) or
# "replaces" (replaces the visitor seat price — confirm before going live!)
INTERNET_BILLING_MODE="surcharge"
# Billing rounding rules: minimum billable minutes, then round up in increments
BILLING_MIN_MINUTES=60
BILLING_INCREMENT_MINUTES=15

# Guest quick-login (fixed shared hotspot accounts, username == password)
# Comma-separated whitelist — each code must already exist on the router
# under the guest-shared profile. Add/remove codes here, no logic changes.
GUEST_QUICK_LOGIN_CODES="100,200,300,400,500"
