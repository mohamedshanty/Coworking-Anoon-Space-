# Database
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# JWT
JWT_ACCESS_SECRET="your-access-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"

# N8N Integration
N8N_API_KEY="your-n8n-api-key-here"

# Server
NODE_ENV=development
PORT=5001

# CORS (comma-separated — include the public ordering page domain here)
ALLOWED_ORIGINS=http://localhost:8080,https://your-ordering-page.com

# SMTP (for daily report emails)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"
SMTP_FROM="Noon Cowork <noreply@example.com>"

# Daily Report
DAILY_REPORT_CRON="55 23 * * *"
DAILY_REPORT_RECIPIENTS="admin@example.com"

# Anoon QR integration
# Shared secret — MUST be the same value on both this backend and the Anoon QR backend.
# Used as X-Internal-Secret header on both directions (inbound check-ins + outbound member sync).
INTERNAL_SYNC_SECRET="your-shared-internal-secret-here"
# Base URL of the standalone Anoon QR backend (no trailing slash needed), e.g. https://anoon-qr.example.com
ANOON_QR_BASE_URL="https://anoon-qr.example.com"
