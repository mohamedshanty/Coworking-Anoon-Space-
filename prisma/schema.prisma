generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Visitor {
  id             String          @id @default(uuid())
  name           String
  phone          String
  type           PersonType
  lastVisit      DateTime?
  followUpStatus FollowUpStatus?
  followUpAt     DateTime?
  source         String?
  notes          String?
  createdAt      DateTime        @default(now())
  debts          Debt[]
  sessions       Session[]
  subscriptions  Subscription[]
  visitorNotes   VisitorNote[]
}

model VisitorNote {
  id        String   @id @default(uuid())
  visitorId String
  content   String
  createdAt DateTime @default(now())
  visitor   Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
}

model Session {
  id                  String               @id @default(uuid())
  visitorId           String
  checkIn             DateTime
  checkOut            DateTime?
  amount              Decimal              @db.Decimal(10, 2)
  paymentStatus       SessionPaymentStatus
  paymentMethod       PaymentMethod?
  notes               String?
  sessionType         String?
  hourlyRate          Decimal?             @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0) @db.Decimal(10, 2)
  discountNote        String?
  paymentAccount      String?
  adjustmentNote      String?
  calculatedPrice     Decimal?             @db.Decimal(10, 2)
  finalPrice          Decimal?             @db.Decimal(10, 2)
  newVisitorDismissed Boolean              @default(false)
  hourlyPriceOverride Decimal?             @db.Decimal(10, 2)
  sales               Sale[]
  visitor             Visitor              @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  snackOrders         SnackOrder[]
}

model SnackOrder {
  id           String         @id @default(uuid())
  sessionId    String
  itemId       String?
  qty          Int
  total        Decimal        @db.Decimal(10, 2)
  isHotDrink   Boolean
  hotDrinkName String?
  drinkId      String?
  drink        Drink?         @relation(fields: [drinkId], references: [id])
  item         InventoryItem? @relation(fields: [itemId], references: [id])
  session      Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Subscription {
  id              String              @id @default(uuid())
  visitorId       String
  packageType     SubscriptionPackage
  startDate       DateTime
  endDate         DateTime
  dailyQuotaHours Int
  daysUsed        Int
  totalFee        Decimal             @db.Decimal(10, 2)
  amountPaid      Decimal             @db.Decimal(10, 2)
  status          SubscriptionStatus
  visitor         Visitor             @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  debts           Debt[]
}

model InventoryItem {
  id              String       @id @default(uuid())
  name            String
  quantity        Int
  sellPrice       Decimal      @db.Decimal(10, 2)
  costPrice       Decimal      @db.Decimal(10, 2)
  lastRestockDate DateTime
  alertThreshold  Int
  snackOrders     SnackOrder[]
}

model HotDrink {
  id        String   @id @default(uuid())
  name      String   @unique
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Drink {
  id              String       @id @default(uuid())
  name            String
  quantity        Int
  sellPrice       Decimal      @db.Decimal(10, 2)
  costPrice       Decimal      @db.Decimal(10, 2)
  lastRestockDate DateTime     @default(now())
  alertThreshold  Int          @default(10)
  unit            DrinkUnit    @default(PIECE)
  orders          SnackOrder[]
}

model Sale {
  id            String        @id @default(uuid())
  itemId        String?
  itemName      String
  quantity      Int
  total         Decimal       @db.Decimal(10, 2)
  sessionId     String?
  linkedName    String?
  paymentMethod PaymentMethod
  isHotDrink    Boolean
  date          DateTime
  customerName  String?
  notes         String?
  session       Session?      @relation(fields: [sessionId], references: [id])
}

model SnackWallet {
  id           String                 @id @default(uuid())
  visitorName  String
  phone        String                 @unique
  balance      Decimal                @db.Decimal(10, 2) @default(0)
  createdAt    DateTime               @default(now())
  transactions SnackWalletTransaction[]
}

model SnackWalletTransaction {
  id            String        @id @default(uuid())
  walletId      String
  sessionId     String?
  orderId       String?
  type          WalletTxnType
  amount        Decimal       @db.Decimal(10, 2)
  balanceBefore Decimal       @db.Decimal(10, 2)
  balanceAfter  Decimal       @db.Decimal(10, 2)
  description   String?
  createdAt     DateTime      @default(now())
  wallet        SnackWallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String          @id @default(uuid())
  description String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime
  notes       String?
}

model Debt {
  id             String        @id @default(uuid())
  visitorId      String?
  subscriptionId String?
  name           String
  phone          String
  amount         Decimal       @db.Decimal(10, 2)
  type           DebtType
  status         DebtStatus
  createdAt      DateTime
  collectedAt    DateTime?
  note           String?
  visitor        Visitor?      @relation(fields: [visitorId], references: [id])
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
}

model Room {
  id       String    @id @default(uuid())
  name     String
  bookings Booking[]
  courses  Course[]
}

model Booking {
  id          String        @id @default(uuid())
  roomId      String
  bookerName  String
  bookerPhone String
  purpose     String
  startTime   DateTime
  endTime     DateTime
  price       Decimal       @db.Decimal(10, 2)
  status      BookingStatus
  room        Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Course {
  id              String    @id @default(uuid())
  name            String
  trainer         String
  startDate       DateTime
  endDate         DateTime
  sessionsCount   Int
  pricePerTrainee Decimal   @db.Decimal(10, 2)
  maxSeats        Int
  roomId          String
  room            Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  trainees        Trainee[]
}

model Trainee {
  id                String               @id @default(uuid())
  courseId          String
  name              String
  phone             String
  amountPaid        Decimal              @db.Decimal(10, 2)
  paymentStatus     TraineePaymentStatus
  attendancePercent Float
  course            Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Staff {
  id             String       @id @default(uuid())
  name           String
  username       String       @unique
  role           StaffRole
  passwordHash   String
  failedAttempts Int          @default(0)
  lockedUntil    DateTime?
  loginLogs      LoginLog[]
  permissions    Permission[]
}

model LoginLog {
  id        String      @id @default(uuid())
  userId    String?
  username  String
  at        DateTime
  status    LoginStatus
  ip        String
  userAgent String?
  staff     Staff?      @relation(fields: [userId], references: [id])
}

model Settings {
  id                    String  @id @default("default")
  hourlyRate            Decimal @db.Decimal(10, 2)
  fullDayPrice          Decimal @db.Decimal(10, 2)
  fullDayThresholdHours Int
  hotDrinksMonthlyCost  Decimal @db.Decimal(10, 2)
  company               Json
}

model Permission {
  id        String  @id @default(uuid())
  staffId   String
  pageKey   String
  canView   Boolean
  canEdit   Boolean
  canDelete Boolean
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, pageKey])
}

model Contact {
  id        String   @id @default(uuid())
  fullName  String
  phone     String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PersonType {
  visitor
  subscriber
  trainee
}

enum SessionPaymentStatus {
  paid
  partial_debt
  full_debt
}

enum PaymentMethod {
  cash
  card
  transfer
  wallet
}

enum SubscriptionPackage {
  monthly
  weekly
  half_month
}

enum SubscriptionStatus {
  active
  expired
  paused
  renewing
}

enum ExpenseCategory {
  electricity
  rent
  salaries
  maintenance
  marketing
  other
}

enum DebtType {
  session
  manual
  subscription
}

enum DebtStatus {
  unpaid
  collected
}

enum BookingStatus {
  confirmed
  pending
  cancelled
}

enum TraineePaymentStatus {
  full
  installment
}

enum StaffRole {
  admin
  manager
  staff
}

enum LoginStatus {
  success
  fail
}

enum FollowUpStatus {
  needs
  contacted
  opt_out
}

enum DrinkUnit {
  PIECE
  OUNCE
  GRAM
  ML
}

enum WalletTxnType {
  topup
  deduction
}
